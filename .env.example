# Auth
AUTH_SECRET=changeme_at_least_32_characters_long_base64_secret_key
AUTH_GOOGLE_ID=your_google_client_id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=your_google_client_secret
AUTH_URL=http://localhost:3000

# Data
DATABASE_URL=postgresql://user:pass@localhost:5432/roasttube
UPSTASH_REDIS_REST_URL=https://example.upstash.io
UPSTASH_REDIS_REST_TOKEN=example_token_at_least_10_chars
SAMPLE_ENC_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA= # 32 bytes base64

# Routing and Caps
ROUTE_EN=nim,groq,gemini
ROUTE_TANGLISH=gemini,nim,groq
ROUTE_HINGLISH=gemini,nim,groq
GLOBAL_LLM_DAILY_CAP=1000
USER_ANALYZE_PER_DAY=3
USER_ROAST_PER_DAY=12

# Ops
CRON_SECRET=changeme_cron_secret_min_16_chars
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
